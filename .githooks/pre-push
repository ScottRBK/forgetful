#!/bin/sh
# Full pipeline: static gates, coverage floor (SQLite + PostgreSQL e2e), Python 3.14
# compatibility, memory budgets, trivy, Qodana, GitNexus.
# Bypass a gate:  SKIP=qodana,trivy git push ...   (see docs/quality-gates.md)
#
# The gates check the working tree, so they only make sense when the commit being pushed is
# the checked-out HEAD. Pushing any other ref (for example `git push origin fix/some-branch`
# from another branch) is not gated here: check out that branch and push it, or run
# `uv run python -m scripts.quality stage pre-push` yourself.
cd "$(git rev-parse --show-toplevel)" || exit 1
head_sha=$(git rev-parse HEAD)
gate=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [ "$local_sha" = "$head_sha" ]; then
        gate=1
    fi
done
if [ "$gate" -eq 0 ]; then
    echo "[pre-push] pushing refs other than the checked-out HEAD: pipeline skipped (it checks the working tree)"
    exit 0
fi
exec uv run --frozen python -m scripts.quality stage pre-push
